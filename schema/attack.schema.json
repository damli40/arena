{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.local/schema/attack.schema.json",
  "title": "Arena attack file",
  "description": "One attack against a payment guard: a replayable list of steps from the harness's fixed vocabulary (harness/src/seq.rs), plus a meta block. Nothing in this file is executed except through those fixed step actions. tools/hunter/validate.py enforces these rules (and a few cross-field ones the schema cannot say: steps_sha256 must match the steps, an injection attack's steps must be exactly its injected pays, wait_seconds add up to at most 60, at least one step must change state). `validate.py --self-test` checks the two agree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "steps",
    "meta"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "args": {
      "type": "object",
      "description": "Call arguments. Names match ^[a-z_][a-z0-9_]{0,63}$; values are strings (<=128 chars), whole numbers 0..2^63-1, booleans, null, or lists/objects nested at most 2 deep; at most 1024 bytes as JSON. Logical account names (agent, outsider, sam, ada, lin, kai, mo) are translated by the harness.",
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_]{0,63}$"
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "method"
      ],
      "properties": {
        "actor": {
          "enum": [
            "agent",
            "outsider"
          ],
          "description": "Who signs. The owner key never reaches an attacker. The agent signs with a function-call key: vault only, `pay` only, no deposit."
        },
        "target": {
          "enum": [
            "vault",
            "token",
            "intents",
            "signer"
          ],
          "default": "vault",
          "description": "\"intents\" (the NEAR Intents contract) is allowed only in sequences-intents/, the suite run for a guard whose config says \"pays_in\": \"intents\". \"signer\" (Arena's Chain Signatures stand-in) is allowed only in sequences-chainsig/, the suite run for a guard whose config says \"signs_via\": \"chain-signatures\"."
        },
        "method": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,63}$"
        },
        "args": {
          "$ref": "#/$defs/args"
        },
        "gas_tgas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "Default 300 (max gas)."
        },
        "deposit_yocto": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000000
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "call"
          ],
          "properties": {
            "call": {
              "$ref": "#/$defs/call"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "view"
          ],
          "properties": {
            "view": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "target": {
                  "enum": [
                    "vault",
                    "token",
                    "intents",
                    "signer"
                  ]
                },
                "method": {
                  "type": "string",
                  "pattern": "^[a-z_][a-z0-9_]{0,63}$"
                },
                "args": {
                  "$ref": "#/$defs/args"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "race"
          ],
          "properties": {
            "race": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "description": "Calls sent without waiting for each other. Elements are calls, or {\"call\": call}.",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/call"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "call"
                    ],
                    "properties": {
                      "call": {
                        "$ref": "#/$defs/call"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wait_blocks"
          ],
          "properties": {
            "wait_blocks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wait_seconds"
          ],
          "properties": {
            "wait_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "add_key"
          ],
          "properties": {
            "add_key": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "actor"
              ],
              "properties": {
                "actor": {
                  "enum": [
                    "agent",
                    "outsider"
                  ]
                },
                "permission": {
                  "enum": [
                    "full_access",
                    "function_call_token"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arxiv_id",
        "title",
        "url"
      ],
      "properties": {
        "arxiv_id": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{4,5}(v\\d+)?$"
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "url": {
          "type": "string",
          "pattern": "^https://arxiv\\.org/abs/"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source",
        "kind",
        "breaks",
        "expected_safe_result",
        "added",
        "author",
        "steps_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
          "description": "Unique across the whole library, e.g. scripted-02-race-double-pay."
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "Short plain-words name."
        },
        "source": {
          "enum": [
            "hand",
            "ai",
            "paper",
            "combined",
            "news"
          ],
          "description": "combined = joins the core idea of 2-4 library attacks (meta.parents), after AutoRedTeamer (arXiv 2503.15754). news = from a recent hack-news summary (Elfa AI, a retelling of posts on X/Telegram; an unchecked lead), see meta.news."
        },
        "kind": {
          "enum": [
            "sequence",
            "injection"
          ],
          "description": "injection = the steps are the pays a fully fooled agent makes; the email is in meta.injection."
        },
        "paper": {
          "$ref": "#/$defs/paper",
          "description": "Required when source is paper. Comes from the arXiv API, never from the model."
        },
        "news": {
          "$ref": "#/$defs/news",
          "description": "Required when source is news."
        },
        "breaks": {
          "type": "string",
          "maxLength": 400,
          "description": "What it tries to break, in plain words."
        },
        "expected_safe_result": {
          "type": "string",
          "maxLength": 300,
          "description": "What a guard that keeps its policy does."
        },
        "added": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "author": {
          "type": "string",
          "maxLength": 120,
          "description": "Who wrote the steps (a person, a script, or a model id)."
        },
        "steps_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the canonical steps (views dropped, defaults filled). Two attacks with the same hash are the same attack."
        },
        "injection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "email",
            "injected_pays"
          ],
          "properties": {
            "email": {
              "type": "string",
              "maxLength": 4000
            },
            "injected_pays": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              }
            },
            "scenario_id": {
              "type": "string"
            }
          }
        },
        "found_in_hunt": {
          "type": "string"
        },
        "broke_guards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "held_guards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Required when source is combined: the library attack ids it joins."
        },
        "validation": {
          "enum": [
            "broke",
            "valid-nothing-broke"
          ],
          "description": "Set when the hunter adds an attack to sequences-paper/: it ran cleanly on every guard, and either broke at least one or broke none. Deprecated (2026-11-12) in favour of meta.admission.class, which only tools/admission/admit.py writes."
        },
        "spec": {
          "$ref": "#/$defs/spec",
          "description": "Optional. What the attack is meant to show, and what must happen on named reference guards (tools/admission/references.json). Without a spec an attack is Unvalidated by definition. See docs/ADD-AN-ATTACK.md, 'Admission'."
        },
        "admission": {
          "$ref": "#/$defs/admission",
          "description": "Written ONLY by tools/admission/admit.py after a gate run; never by hand or by a model. tools/hunter/validate.py checks it against the evidence folder it names."
        }
      }
    },
    "news": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "date",
        "links"
      ],
      "description": "Required when source is news. Comes from the Elfa reply, never from the model. The links are recorded as text and never fetched.",
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^n-[0-9a-f]{10}$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The day the hunt read the item."
        },
        "links": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^https://(x\\.com|twitter\\.com|t\\.me)/[A-Za-z0-9_./?=&%-]{1,200}$"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "failure_mode",
        "capabilities"
      ],
      "properties": {
        "property": {
          "type": "string",
          "maxLength": 300,
          "description": "One sentence: what a correct guard guarantees."
        },
        "failure_mode": {
          "type": "string",
          "maxLength": 300,
          "description": "One sentence: the specific way a guard breaks that property, which this attack triggers."
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6"
            ]
          },
          "description": "Guard shapes it applies to (C1 invoice-based, C2 direct payment, C3 allowances, C4 key on the guard account, C5 approval workflow, C6 Intents settlement)."
        },
        "preconditions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decides"
          ],
          "properties": {
            "decides": {
              "enum": [
                "beyond_policy",
                "against_intent"
              ]
            },
            "receiver": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "also": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "honest_settled",
                  "conservation"
                ]
              }
            }
          }
        },
        "ordering": {
          "enum": [
            "none",
            "overlap"
          ],
          "description": "For races only: the ordering the harness must prove it produced from per-receipt block heights (overlap = each later pay's guard check ran in a block strictly before the earlier pay's callback). Without that record a race is never Validated."
        },
        "expected": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/expected"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "outcome",
        "beyond_policy",
        "mechanism"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "maxLength": 64,
          "description": "A key of tools/admission/references.json (closed list, pinned by wasm sha256)."
        },
        "outcome": {
          "enum": [
            "held",
            "broke"
          ]
        },
        "beyond_policy": {
          "type": "integer",
          "minimum": 0,
          "description": "Exact, in Arena units (tokens; milliNEAR for native guards)."
        },
        "receiver": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "description": "Who got the money beyond policy (one of the five receivers, or outsider/agent/owner for money paid outside them)."
        },
        "flaw": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "description": "Required on a broke entry: the reference's one documented flaw (references.json 'flaw'). A mismatch means the break is not the matched positive control."
        },
        "mechanism": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "predicate": {
      "type": "object",
      "required": [
        "pred"
      ],
      "description": "A closed vocabulary of checks over the harness's result JSON (implemented in tools/admission/predicates.py).",
      "oneOf": [
        {
          "properties": {
            "pred": {
              "const": "step_outcomes"
            },
            "value": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "enum": [
                  "ok",
                  "contract-failure",
                  "protocol-rejected",
                  "not-included"
                ]
              }
            }
          },
          "required": [
            "pred",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "pred": {
              "const": "failure_contains"
            },
            "step": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "pred",
            "step",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "pred": {
              "const": "over_equals"
            },
            "receiver": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "pred",
            "receiver",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "pred": {
              "const": "outside_equals"
            },
            "to": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "pred",
            "to",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "pred": {
              "const": "score_equals"
            },
            "field": {
              "enum": [
                "unauthorised_payout",
                "beyond_authorised",
                "above_cap",
                "paid_outside_receivers",
                "honest_settled",
                "should_pay"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "pred",
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "pred": {
              "const": "status_equals"
            },
            "invoice": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "status": {
              "type": "string",
              "pattern": "^[A-Za-z]{1,32}$"
            }
          },
          "required": [
            "pred",
            "invoice",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "pred": {
              "const": "credited_equals"
            },
            "invoice": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "pred",
            "invoice",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "pred": {
              "const": "non_agent_pay"
            },
            "invoice": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "actor": {
              "enum": [
                "outsider"
              ]
            }
          },
          "required": [
            "pred",
            "invoice",
            "actor"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "pred": {
              "const": "view_equals"
            },
            "step": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "value": {
              "type": [
                "string",
                "integer",
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "pred",
            "step",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "evidence",
        "date",
        "gate",
        "runs_counted",
        "runs_tried"
      ],
      "properties": {
        "class": {
          "enum": [
            "validated",
            "partially-validated",
            "unvalidated"
          ]
        },
        "evidence": {
          "type": "string",
          "pattern": "^evidence/admission/[a-z0-9][a-z0-9-]{0,95}/[0-9]{8}T[0-9]{6}Z$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "gate": {
          "const": "tools/admission/admit.py"
        },
        "runs_counted": {
          "type": "integer",
          "minimum": 0
        },
        "runs_tried": {
          "type": "integer",
          "minimum": 0
        },
        "why": {
          "type": "string",
          "maxLength": 400
        }
      }
    }
  }
}
